%bcond_without libsecret

Name:           adbxplorer
Version:        @VERSION@
Release:        1%{?dist}
Summary:        MCP-backed database exploration tool

License:        MIT AND LicenseRef-Commons-Clause AND BSD-3-Clause
URL:            https://example.invalid/adbxplorer
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  pkgconf-pkg-config
BuildRequires:  pkgconfig(libpq)
%if %{with libsecret}
BuildRequires:  pkgconfig(libsecret-1)
%endif

%description
adbxplorer is a local broker plus MCP server for safe database exploration.

%prep
%autosetup

%build
%if %{with libsecret}
make build/adbxplorer VERSION=%{version} WITH_LIBSECRET=1
%else
make build/adbxplorer VERSION=%{version} WITH_LIBSECRET=0
%endif

%install
rm -rf %{buildroot}
%if %{with libsecret}
make install PREFIX=%{_prefix} DESTDIR=%{buildroot} VERSION=%{version} WITH_LIBSECRET=1
%else
make install PREFIX=%{_prefix} DESTDIR=%{buildroot} VERSION=%{version} WITH_LIBSECRET=0
%endif

%files
%license LICENSE
%license third_party/libpg_query/LICENSE
%doc ACKNOWLEDGEMENTS.md
%doc README.md
%doc SECURITY.md
%{_bindir}/adbxplorer

%changelog
* Sat Mar 28 2026 Local Builder <local@example.com> - @VERSION@-1
- Initial local test package
